{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!dist", "!storybook-static", "!index.html"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noAssignInExpressions": "off" },
      "style": {
        "noNonNullAssertion": "off",
        "noParameterAssign": "off",
        "useConsistentArrayType": { "level": "error", "options": { "syntax": "shorthand" } }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/styles/**"],
      "formatter": { "enabled": false },
      "linter": {
        "rules": {
          "style": { "noDescendingSpecificity": "off" },
          "correctness": { "noUnknownProperty": "off" }
        }
      }
    },
    {
      "includes": ["src/lib/tezawari/**"],
      "linter": {
        "rules": {
          "security": { "noDangerouslySetInnerHtml": "off" },
          "suspicious": { "noBitwiseOperators": "off" },
          "complexity": { "noExcessiveCognitiveComplexity": "off" }
        }
      }
    },
    {
      "includes": ["src/components/Select.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementToInteractiveRole": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/Rule.tsx"],
      "linter": { "rules": { "a11y": { "useSemanticElements": "off" } } }
    },
    {
      "includes": ["**/*.stories.tsx"],
      "linter": { "rules": { "suspicious": { "noArrayIndexKey": "off" } } }
    }
  ]
}
