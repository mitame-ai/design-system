{
  "name": "@mitame-ai/design-system",
  "version": "0.3.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitame-ai/design-system.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "手触り / Tezawari — an organic, hand-made interface language for React",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles/theme.css",
    "harness",
    "design",
    "DESIGN.md",
    ".agents/skills/tezawari-install",
    ".agents/skills/tezawari-build",
    ".agents/skills/tezawari-review",
    ".agents/skills/tezawari-improve",
    "examples/consumer"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/tezawari.css",
    "./package.json": "./package.json",
    "./theme.css": "./src/styles/theme.css",
    "./harness": "./harness/core.mjs",
    "./design/catalog.json": "./design/generated/catalog.json"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "design:generate": "node scripts/design-generate.mjs",
    "design:drift": "node scripts/design-generate.mjs --check",
    "design:check": "node scripts/design-verify.mjs",
    "test:harness": "node --test test/harness.test.mjs",
    "test:ssr": "node --test test/ssr.test.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "playwright": "1.63.0",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.13.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/react-vite": "^9.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "postcss": "8.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^9.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "bin": {
    "mitame-design": "./harness/cli.mjs",
    "tezawari-design": "./harness/cli.mjs"
  }
}
